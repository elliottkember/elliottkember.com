---
import Base from '../layouts/Base.astro';
import { site } from '../site';
const experience = [
  { period: '2020 — now', role: 'Staff Software Engineer', org: 'OpenSpace', note: 'Led the mobile team, building in React Native. Shipped hundreds of high-quality releases.' },
  { period: '2018 — 2020', role: 'Staff Software Engineer', org: 'Clearbit', note: 'Full-stack software engineer' },
  { period: '2016 — 2018', role: 'Technical Director', org: 'Ueno', note: 'Led the San Francisco engineering team' },
  { period: '2015 — 2016', role: 'Prototype', org: 'Dropbox', note: 'Experimental product design for Dropbox and Mailbox' },
];
const patents = [
  {
    period: '2024, 2025',
    title: 'Rendering depth-based three-dimensional model with integrated image frames',
    org: 'Open Space Labs',
    note: 'Aligning a LIDAR-derived 3D model with a simultaneously captured image sequence, so selecting a location in the model surfaces the photograph taken there.',
    grants: [
      { number: 'US 11,922,591', url: 'https://patents.google.com/patent/US11922591B2/en' },
      { number: 'US 12,249,037', url: 'https://patents.google.com/patent/US12249037B2/en' },
    ],
  },
];
---
<Base title="About" description={`About ${site.name}.`}>
  <section class="pt-16 grid md:grid-cols-[1fr_2fr] gap-10">
    <h1 class="font-display font-light text-5xl tracking-tight">About</h1>
    <div class="prose">
      <p>I am a Staff Software Engineer with a passion for building high-quality web and mobile applications. I focus on creating seamless user experiences and writing maintainable, scalable code. These days, I mostly make sure Claude doesn't do anything untoward.</p>
      <p>Currently based in {site.location}. Reach me at <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
    </div>
  </section>
  <section class="mt-24 grid md:grid-cols-[1fr_2fr] gap-10 reveal">
    <h2 class="font-display text-3xl">Experience</h2>
    <ol class="divide-y divide-line">
      {experience.map((e) => (
        <li class="py-6 grid sm:grid-cols-[8rem_1fr] gap-2">
          <span class="text-sm text-muted tabular-nums">{e.period}</span>
          <div>
            <p class="font-medium">{e.role} · <span class="text-muted">{e.org}</span></p>
            <p class="mt-1 text-muted">{e.note}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>
  <section class="mt-24 grid md:grid-cols-[1fr_2fr] gap-10 reveal">
    <h2 class="font-display text-3xl">Patents</h2>
    <ol class="divide-y divide-line">
      {patents.map((p) => (
        <li class="py-6 grid sm:grid-cols-[8rem_1fr] gap-2">
          <span class="text-sm text-muted tabular-nums">{p.period}</span>
          <div>
            <p class="font-medium">{p.title} · <span class="text-muted">{p.org}</span></p>
            <p class="mt-1 text-muted">{p.note}</p>
            <p class="mt-2 text-sm tabular-nums flex flex-wrap gap-x-4 gap-y-1">
              {p.grants.map((g) => (
                <a href={g.url} rel="noopener">{g.number}</a>
              ))}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </section>
</Base>
